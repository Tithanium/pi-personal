{
  "name": "@nehlis/pi-effort",
  "version": "0.1.0",
  "description": "Pi extension that adds /effort for quickly changing reasoning/thinking level.",
  "type": "module",
  "license": "MIT",
  "author": "Niels Bosman <nielsbosman@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niels-bosman/pi-effort.git"
  },
  "bugs": {
    "url": "https://github.com/niels-bosman/pi-effort/issues"
  },
  "homepage": "https://github.com/niels-bosman/pi-effort#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "reasoning-effort",
    "thinking-level",
    "effort",
    "slash-command"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/effort.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "typescript": "^5.9.3"
  }
}
