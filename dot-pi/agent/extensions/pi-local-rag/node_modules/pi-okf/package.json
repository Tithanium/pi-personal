{
  "name": "pi-okf",
  "version": "0.4.0",
  "description": "CLI for creating and validating Open Knowledge Format (OKF) v0.2 bundles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaishin/pi-okf.git"
  },
  "bugs": {
    "url": "https://github.com/kaishin/pi-okf/issues"
  },
  "homepage": "https://github.com/kaishin/pi-okf#readme",
  "author": "Kaishin",
  "type": "module",
  "bin": {
    "pi-okf": "bin/pi-okf.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js",
    "./validate": "./dist/validate.js",
    "./frontmatter": "./dist/frontmatter.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "extensions/**/*.ts",
    "prompts/**/*.md",
    "skills/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "okf",
    "open-knowledge-format",
    "knowledge-catalog",
    "pi-package",
    "cli"
  ],
  "okf": {
    "specVersion": "0.2",
    "specSha": "main",
    "specUrl": "https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md"
  },
  "pi": {
    "extensions": [
      "./extensions/okf.ts"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "pi-okf": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pi": "tsx --test tests/pi-cli-smoke.test.ts tests/pi-harness.test.ts",
    "validate": "npm run check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/adm-zip": "^0.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.5",
    "typebox": "^1.0.32",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
